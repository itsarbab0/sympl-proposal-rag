# ==============================================================================
# Sympl Solutions Proposal RAG — Production Environment Configuration
# ==============================================================================
# Copy this file to .env or inject these variables into your production environment
# (e.g., Docker Compose, Kubernetes secrets, or container orchestration platforms).

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database connection URI. Must have pgvector extension installed.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:production_secure_password_2026@postgres.internal:5432/sympl_proposals?sslmode=prefer

# ------------------------------------------------------------------------------
# 2. Large Language Model (LLM) Configuration
# ------------------------------------------------------------------------------
# Active LLM provider used by Proposal Writer. Options: openrouter, gemini, mock
LLM_PROVIDER=openrouter

# OpenRouter API Key (required when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-production-key-placeholder-replace-with-real-key

# Specific model identifier to request via OpenRouter
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 3. Embeddings & Semantic Retrieval Configuration
# ------------------------------------------------------------------------------
# Embedding model name for vector semantic retrieval. Default: BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3

# Vector embedding dimension. BAAI/bge-m3 produces 1024-dimensional dense vectors.
EMBEDDING_DIMENSION=1024

# ------------------------------------------------------------------------------
# 4. Security & Access Control
# ------------------------------------------------------------------------------
# Runtime environment identifier. Options: production, staging, development
# When set to 'production', API key authentication is strictly enforced.
ENVIRONMENT=production

# Comma-separated list of active API keys for zero-downtime key rotation.
# Clients must pass one of these keys in the 'X-API-Key' HTTP header.
API_KEYS=sympl-prod-key-alpha-2026,sympl-prod-key-beta-2026

# Allowed CORS origins for browser/web consumers. Comma-separated domains.
# In production, never use wildcard '*' when credentials are enabled.
CORS_ORIGINS=https://app.sympl.com,https://admin.sympl.com

# Controls visibility of interactive Swagger/Redoc API documentation in production.
# Recommended: false for production external visibility.
DOCS_ENABLED=false

# ------------------------------------------------------------------------------
# 5. Canva Presentation & Rendering Configuration
# ------------------------------------------------------------------------------
# Canva API Key for generating interactive Canva presentations
CANVA_API_KEY=cnv_live_placeholder_token_replace_with_real

# Master Canva proposal presentation template ID
CANVA_TEMPLATE_ID=tmpl_sympl_standard_corporate_v2

# ------------------------------------------------------------------------------
# 6. Artifact Storage Configuration
# ------------------------------------------------------------------------------
# Storage backend for proposal artifacts (plans, drafts, renders, intakes).
# Options: local, s3
ARTIFACT_STORAGE=local

# Base directory for local artifact storage (mounted as persistent volume in Docker)
STORAGE_DIR=/app/data/proposals

# ------------------------------------------------------------------------------
# 7. Reliability, Timeouts & Resilience
# ------------------------------------------------------------------------------
# Maximum incoming HTTP request payload size in bytes (1MB = 1048576 bytes)
MAX_REQUEST_SIZE_BYTES=1048576

# Maximum timeout in seconds for LLM generation calls
LLM_TIMEOUT_SECONDS=30

# Maximum number of retries on transient LLM generation failures
LLM_MAX_RETRIES=2

# Polling interval in seconds for the background worker daemon
WORKER_POLL_INTERVAL=2.0

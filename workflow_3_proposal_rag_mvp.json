      "name": "Proposal Generation Rejected",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        680,
        520
      ],
      "notesInFlow": true,
      "notes": "Emits rejection payload if human approver selects REJECT."

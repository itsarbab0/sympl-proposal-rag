              "value": "={{$json.poll_count}}",
              "type": "number"
            },
            {
              "id": "to-msg",
              "name": "message",
              "value": "Proposal generation polling timed out after 5 minutes (60 attempts).",
              "type": "string"
            }
          ]
        }
      },
      "id": "node-poll-timeout-response",
      "name": "Poll Timeout Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2600,
        720
      ],
      "notesInFlow": true,
      "notes": "Emits timeout response payload when max polling duration is exceeded."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://sympl-proposal-rag-production.up.railway.app/api/v1/proposal/{{$('IF Completed?').first().json.proposal_id || $json.proposal_id}}/pdf",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.RAG_API_KEY}}"
            }
          ]
        },
        "responseFormat": "file",
        "outputDataPropertyName": "proposal.pdf",
        "options": {

      "name": "Retrieve Generated PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        300
      ],
      "notesInFlow": true,
      "notes": "NODE 10: Downloads binary proposal.pdf using hardened reference to IF Completed? proposal_id."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://sympl-proposal-rag-production.up.railway.app/api/v1/proposal/{{$('IF Completed?').first().json.proposal_id || $json.proposal_id}}/manifest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.RAG_API_KEY}}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "node-get-manifest",
      "name": "Retrieve Manifest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3320,
        300
      ],
      "notesInFlow": true,
      "notes": "NODE 11: Fetches manifest.json to verify all 5 proposal artifacts and SHA256 hashes."
    },
    {
      "parameters": {
        "jsCode": "// NODE 12: PREPARE CANVA IMPORT HANDOFF\nconst manifest = $input.first().json;\nconst proposalId = $('IF Completed?').first().json.proposal_id;\n\nreturn [{\n  json: {\n    proposal_id: proposalId,\n    file: 'proposal.pdf',\n    action: 'IMPORT_TO_CANVA',\n    canva_status: 'READY_FOR_CANVA',\n    manifest_verified: manifest.all_artifacts_present === true || manifest.artifact_count === 5\n  }\n}];"
      },
      "id": "node-canva-handoff-prep",
      "name": "Prepare Canva Import Handoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3560,
        300
      ],
      "notesInFlow": true,
      "notes": "NODE 12: Prepares standardized import payload with canva_status: 'READY_FOR_CANVA'."
    },
    {
      "parameters": {
        "jsCode": "// CANVA IMPORT SERVICE PLACEHOLDER\n// This will later connect to our pipeline backend which handles:\n// - Canva OAuth\n// - Canva client secret\n// - Canva import API\n// - design creation\n\nconst item = $input.first().json;\nreturn [{\n  json: {\n    ...item,\n    canva_service_dispatched: true,\n    canva_status: 'READY_FOR_CANVA',\n    service_note: 'Handoff payload prepared. Awaiting Canva Connect API integration.'\n  }\n}];"

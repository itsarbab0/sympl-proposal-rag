        "resume": "form",
        "formTitle": "Human Scope Approval Gate",
        "formDescription": "=Review and approve billable scope for client: {{$('User Proposal Form').first().json.client_name}} ({{$('User Proposal Form').first().json.organization_type}} - {{$('User Proposal Form').first().json.sector}})\nAmount: {{$('User Proposal Form').first().json.currency || 'CAD'}} {{$('User Proposal Form').first().json.amount}} ({{$('User Proposal Form').first().json.pricing_model}})",

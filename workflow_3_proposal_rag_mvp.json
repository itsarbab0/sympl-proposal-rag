      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2120,
        300
      ],
      "notesInFlow": true,
      "notes": "NODE 5: Initializes polling state with job_id and initial poll_count = 0."
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },

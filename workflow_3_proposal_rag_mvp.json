    {
      "parameters": {
        "jsCode": "const approval = $input.first().json;\nconst form = $('User Proposal Form').first().json;\n\n// Build approved_scope strictly from reviewer human selections\nconst approvedScope = {\n  bookkeeping: Boolean(approval['Approve Bookkeeping'] !== undefined ? approval['Approve Bookkeeping'] : form.bookkeeping),\n  payroll: Boolean(approval['Approve Payroll'] !== undefined ? approval['Approve Payroll'] : form.payroll),\n  financial_reporting: Boolean(approval['Approve Financial Reporting'] !== undefined ? approval['Approve Financial Reporting'] : form.financial_reporting),\n  compliance: Boolean(approval['Approve Compliance'] !== undefined ? approval['Approve Compliance'] : form.compliance),\n  digital_transformation: Boolean(approval['Approve Digital Transformation'] !== undefined ? approval['Approve Digital Transformation'] : form.digital_transformation),\n  transition: Boolean(approval['Approve Transition'] !== undefined ? approval['Approve Transition'] : form.transition)\n};\n\nreturn [{\n  json: {\n    client_name: String(form.client_name || '').trim(),\n    organization_type: String(form.organization_type || 'Nonprofit').trim().toLowerCase(),\n    sector: String(form.sector || 'community_services').trim(),\n    engagement_type: String(form.engagement_type || 'Recurring').trim().toLowerCase(),\n    complexity: String(form.complexity || 'Standard').trim().toLowerCase(),\n    approved_scope: approvedScope,\n    commercial_terms: {\n      pricing_model: String(form.pricing_model || 'fixed_retainer').trim(),\n      currency: String(form.currency || 'CAD').trim(),\n      amount: Number(form.amount || 0)\n    },\n    callback_url: ''\n  }\n}];"
      },
      "id": "node-prepare-payload",
      "name": "Prepare Proposal Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        300
      ],
      "notesInFlow": true,
      "notes": "NODE 3: Formats approved form inputs into strict RAG intake schema."
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst errors = [];\n\n// 1. Client information check\nif (!payload.client_name || typeof payload.client_name !== 'string' || !payload.client_name.trim()) {\n  errors.push('client_name is required and must be a non-empty string.');\n}\n\n// 2. Approved scope validation: at least one service must be approved\nconst scope = payload.approved_scope || {};\nconst activeServices = Object.keys(scope).filter(k => Boolean(scope[k]));\nif (activeServices.length === 0) {\n  errors.push('approved_scope must contain at least one approved service family.');\n}\n\n// 3. Commercial terms validation\nconst terms = payload.commercial_terms || {};\nif (!terms.pricing_model || typeof terms.pricing_model !== 'string' || !terms.pricing_model.trim()) {\n  errors.push('commercial_terms.pricing_model is required.');\n}\nif (!terms.currency || typeof terms.currency !== 'string' || !terms.currency.trim()) {\n  errors.push('commercial_terms.currency is required.');\n}\nif (typeof terms.amount !== 'number' || terms.amount <= 0 || isNaN(terms.amount)) {\n  errors.push('commercial_terms.amount must be a positive number greater than 0.');\n}\n\nconst isValid = errors.length === 0;\n\nreturn [{\n  json: {\n    ...payload,\n    is_valid_request: isValid,\n    validation_errors: errors\n  }\n}];"
      },
      "id": "node-validate-proposal-request",
      "name": "Validate Proposal Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
